# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/neurashield
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# AI/ML Configuration
HUGGINGFACE_TOKEN=your_huggingface_token_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-west1-gcp

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Neural Shields Configuration
CODE_BRAIN_MODEL=microsoft/codebert-base
SECURITY_SHIELD_THRESHOLD=0.7
DEVOPS_OPTIMIZER_LEARNING_RATE=0.001

# External Integrations
GITHUB_TOKEN=your_github_token_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true